# Production Environment Configuration
# Copy this to your hosting environment variables (cPanel, Vercel, etc.)
# NEVER commit this file with real values

# Environment Mode
# Set to 'production' in production, 'development' locally
NODE_ENV=production
APP_ENV=production

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-EXPOSE-TO-CLIENT

# Security Configuration
JWT_SECRET=generate-64-character-random-secret
ENCRYPTION_KEY=generate-32-character-random-key
SESSION_SECRET=generate-64-character-random-secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@yourdomain.com

# M-Pesa Production Configuration
MPESA_CONSUMER_KEY=your-production-consumer-key
MPESA_CONSUMER_SECRET=your-production-consumer-secret
MPESA_SHORTCODE=your-production-shortcode
MPESA_PASSKEY=your-production-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa-callback
MPESA_ENVIRONMENT=production

# Security Settings
REQUEST_SIGNING_KEY=generate-request-signing-key
ADMIN_IP_WHITELIST=your-office-ip,another-trusted-ip
PASSWORD_MIN_LENGTH=12
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Domain Configuration
DOMAIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=error
LOG_FILE=/var/log/stokika/app.log
