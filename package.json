{
  "name": "stokika",
  "version": "1.0.0",
  "description": "B2B Marketplace Platform - Security-Hardened",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production node build.config.js",
    "build:dev": "cross-env NODE_ENV=development node build.config.js",
    "build:win": "set NODE_ENV=production && node build.config.js",
    "watch": "node build.config.js watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "echo \"ESLint disabled: typescript-eslint doesn't support TS 7.0 yet. Using typecheck + prettier instead.\" && npm run typecheck && npm run format:check",
    "lint:fix": "npm run format",
    "prepare": "husky"
  },
  "keywords": [
    "b2b",
    "marketplace",
    "supabase",
    "mpesa",
    "kenya"
  ],
  "author": "Stokika Development Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/ui": "^2.1.9",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
