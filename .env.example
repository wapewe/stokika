# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-EXPOSE-TO-CLIENT

# Security Configuration
# Generate strong random keys using: openssl rand -base64 32
JWT_SECRET=generate-a-strong-random-secret-key-here-64-characters-minimum
ENCRYPTION_KEY=generate-a-strong-random-encryption-key-here-32-characters
SESSION_SECRET=generate-a-strong-random-session-secret-here-64-characters

# Email Configuration (for OTP)
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-app-specific-password-here
FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW=15
OTP_EXPIRY_MINUTES=10

# Kit Payment Configuration
FIELD_AGENT_KIT_PRICE=2500
SUPERVISOR_KIT_PRICE=3500
PAYMENT_VERIFICATION_REQUIRED=true

# M-Pesa Configuration - PRODUCTION SETTINGS
# ⚠️ IMPORTANT: Use production credentials for live environments
# Get production credentials from: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your-production-consumer-key-from-safaricom
MPESA_CONSUMER_SECRET=your-production-consumer-secret-from-safaricom
MPESA_SHORTCODE=your-production-paybill-shortcode
MPESA_PASSKEY=your-production-passkey-from-safaricom
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa-callback
MPESA_ENVIRONMENT=production

# For testing only, use sandbox:
# MPESA_ENVIRONMENT=sandbox
# MPESA_SHORTCODE=174379
# Get sandbox credentials from: https://developer.safaricom.co.ke/test_credentials

# Security Configuration (Additional)
REQUEST_SIGNING_KEY=generate-request-signing-key-here
ADMIN_IP_WHITELIST=127.0.0.1,::1,your-office-ip-here
PASSWORD_MIN_LENGTH=12
SESSION_TIMEOUT_MINUTES=30
LOCKOUT_DURATION_MINUTES=30

# Production Settings
NODE_ENV=production
DOMAIN=https://yourdomain.com
