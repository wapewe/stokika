{
  "compilerOptions": {
    // Strict Type Checking - Requirement 1.1
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    // Module Resolution
    "module": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Output Configuration - Requirement 1.2
    "outDir": "./dist",
    "rootDir": "./src",

    // Target and Library - Requirements 25.7 (ES2017 for browser compatibility)
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],

    // Source Maps - Requirement 1.7
    "sourceMap": true,
    "inlineSources": false,
    "declaration": false,

    // Emit Configuration
    "removeComments": false,
    "preserveConstEnums": true,
    "skipLibCheck": true,

    // Additional Type Checking
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Advanced Options
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // Path Mappings for Clean Imports
    "paths": {
      "*": ["./*"],
      "@config/*": ["./src/config/*"],
      "@types/*": ["./src/types/*"],
      "@lib/*": ["./src/lib/*"],
      "@services/*": ["./src/services/*"],
      "@features/*": ["./src/features/*"],
      "@ui/*": ["./src/ui/*"],
      "@utils/*": ["./src/utils/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },

  // Files to Include
  "include": [
    "src/**/*"
  ],

  // Files to Exclude
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "backups",
    "tests",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
